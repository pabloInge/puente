# Base de datos PostgreSQL (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgres://usuario:password@host:5432/puente"

# Autenticación (Better Auth)
# Generar un secret aleatorio con: openssl rand -base64 32
BETTER_AUTH_SECRET="tu-secreto-aleatorio-de-al-menos-32-caracteres"
BETTER_AUTH_URL="https://tu-proyecto.vercel.app"

# Seguridad y Cifrado
# Clave de 32 bytes en base64 para cifrado de DNI: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="clave-base64-de-32-bytes"

# Protección de Crons en Vercel
CRON_SECRET="secreto-para-endpoints-cron"

# Videollamadas (Opcional - Daily.co)
DAILY_API_KEY=""
